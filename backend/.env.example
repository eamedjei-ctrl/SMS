# Appendix D -- environment variables.
# Copy to .env and fill in. NEVER commit .env; it is git-ignored.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Application ---
FLASK_ENV=development          # development | staging | production
SECRET_KEY=
APP_BASE_DOMAIN=schoolos.com   # tenants resolve as {subdomain}.{APP_BASE_DOMAIN}
LOG_LEVEL=INFO
CORS_ORIGINS=*                 # comma-separated origins in production

# --- Database ---
DATABASE_URL=postgresql+psycopg://schoolos:schoolos@localhost:5432/schoolos
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (logical databases per purpose, spec 3.5) ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2
REDIS_RATELIMIT_DB=3

# --- Auth ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8

# --- Storage (report card PDFs) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/lib/schoolos/storage

# --- Compose / deployment only ---
POSTGRES_DB=schoolos
POSTGRES_USER=schoolos
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
API_PORT=8000
GUNICORN_WORKERS=3

